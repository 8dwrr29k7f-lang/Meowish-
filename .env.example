# ============================================================
# XVANTAGE // Kalshi 15-Minute BTC Bot - Configuration
# ============================================================
# Copy this file to .env and fill in values.
# NEVER commit your real .env or private key.

# --- Mode ---
PAPER_TRADE=true          # true = simulate only (recommended)
KALSHI_ENV=demo           # demo or prod  (prod uses live market data even in paper)
AUTO_TRADE=false          # when --web, set true to actually place paper/live orders

# --- API Credentials (only needed when PAPER_TRADE=false) ---
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=./kalshi_private_key.pem

# --- Market ---
SERIES=KXBTC15M           # KXBTC15M (BTC) or KXETH15M (ETH)

# --- Sizing & Risk ---
STAKE_USD=5.0             # Dollars risked per directional trade
MAX_DAILY_LOSS_USD=30.0   # Stop trading for the day after this loss
MAX_POSITIONS=3           # Max concurrent positions
COOLDOWN_SECONDS=30       # Min seconds between new entries

# --- Strategy Thresholds ---
MIN_CONFIDENCE=0.55
MIN_EDGE_CENTS=3
SCALP_TAKE_PROFIT_CENTS=4
SCALP_STOP_LOSS_CENTS=6
ARB_MAX_COMBINED=98       # Buy both YES+NO if ask sum <= this (cents)

# --- Timing ---
POLL_SECONDS=2            # How often to poll markets (seconds)
